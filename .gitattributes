# Shell scripts and Dockerfiles must keep LF endings: a stray CR breaks the
# container entrypoint (#!/bin/bash\r) and Dockerfile instruction parsing.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.html          text eol=lf
